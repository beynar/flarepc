{
	"name": "flarepc",
	"version": "0.0.62",
	"private": false,
	"scripts": {
		"deploy": "wrangler deploy",
		"dev": "wrangler dev",
		"build": "tsup && node fixBuildTypes.js",
		"build-dev": "tsup --watch && node fixBuildTypes.js",
		"start": "wrangler dev",
		"test": "vitest --ui"
	},
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.mjs",
			"module": "./dist/index.mjs",
			"require": "./dist/index.js",
			"default": "./dist/index.js"
		},
		"./client": {
			"types": "./dist/client.d.ts",
			"import": "./dist/client.mjs",
			"module": "./dist/client.mjs",
			"require": "./dist/client.js",
			"default": "./dist/client.js"
		},
		"./yjs": {
			"types": "./dist/yjs/index.d.ts",
			"import": "./dist/yjs/index.mjs",
			"module": "./dist/yjs/index.mjs",
			"require": "./dist/yjs/index.js",
			"default": "./dist/yjs/index.js"
		},
		"./yjs/client": {
			"types": "./dist/yjs/client.d.ts",
			"import": "./dist/yjs/client.mjs",
			"module": "./dist/yjs/client.mjs",
			"require": "./dist/yjs/client.js",
			"default": "./dist/yjs/client.js"
		}
	},
	"types": "./dist/index.d.ts",
	"files": [
		"dist",
		"!dist/**/*.test.*",
		"!dist/**/*.spec.*"
	],
	"devDependencies": {
		"@cloudflare/vitest-pool-workers": "^0.7.2",
		"@cloudflare/workers-types": "^4.20250214.0",
		"@types/bun": "^1.2.2",
		"@types/cookie": "^0.6.0",
		"@vitest/ui": "^3.0.7",
		"tsup": "^8.3.6",
		"type-fest": "^4.35.0",
		"typescript": "^5.7.3",
		"vitest": "3.0.7",
		"wrangler": "^3.109.2"
	},
	"dependencies": {
		"cookie": "^0.6.0",
		"cron-parser": "^5.0.4",
		"devalue": "^5.1.1",
		"lib0": "^0.2.99",
		"mrmime": "^2.0.1",
		"y-protocols": "^1.0.6",
		"yjs": "^13.6.23",
		"zod": "^3.24.2"
	},
	"typesVersions": {
		"*": {
			"yjs": [
				"./dist/yjs/index.d.ts"
			],
			"yjs/client": [
				"./dist/yjs/client.d.ts"
			],
			"client": [
				"./dist/client.d.ts"
			]
		}
	}
}
